# ==============================================================================
# Needly Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit real API secrets or credentials to git.

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public Supabase Project URL (Client-safe)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public Supabase Anonymous Key (Client-safe, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Secret Supabase Service Role Key (SERVER-ONLY - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Supabase JWT Secret for webhook and token validation (Server-only)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# Public URL for base canonical domain and email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
